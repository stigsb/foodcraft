{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "foodcraft:rice_crop",
      "menu_category": { "category": "none" },
      "states": { "foodcraft:growth": [0, 1, 2, 3] }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.cross",
      "minecraft:material_instances": {
        "*": { "texture": "foodcraft_rice_crop_0", "render_method": "alpha_test_single_sided", "ambient_occlusion": 0 }
      },
      "minecraft:collision_box": false,
      "minecraft:selection_box": { "origin": [-7, 0, -7], "size": [14, 10, 14] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0 },
      "minecraft:light_dampening": 0,
      "minecraft:placement_filter": {
        "conditions": [{ "allowed_faces": ["up"], "block_filter": ["minecraft:farmland"] }]
      },
      "minecraft:loot": "loot_tables/blocks/rice_crop_seed.json",
      "foodcraft:crop": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('foodcraft:growth') == 1",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "foodcraft_rice_crop_1", "render_method": "alpha_test_single_sided", "ambient_occlusion": 0 }
          }
        }
      },
      {
        "condition": "q.block_state('foodcraft:growth') == 2",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "foodcraft_rice_crop_2", "render_method": "alpha_test_single_sided", "ambient_occlusion": 0 }
          }
        }
      },
      {
        "condition": "q.block_state('foodcraft:growth') == 3",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "foodcraft_rice_crop_3", "render_method": "alpha_test_single_sided", "ambient_occlusion": 0 }
          },
          "minecraft:loot": "loot_tables/blocks/rice_crop_mature.json"
        }
      }
    ]
  }
}
