{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "foodcraft:mackerel",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "spawn_category": "water_ambient"
    },
    "component_groups": {
