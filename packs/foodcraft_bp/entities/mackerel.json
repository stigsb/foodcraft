      "minecraft:breathable": {
        "breathes_air": false,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:movement": {
        "value": 0.1
      },
      "minecraft:underwater_movement": {
        "value": 0.1
      },
      "minecraft:movement.sway": {
        "sway_amplitude": 0
      },
      "minecraft:navigation.generic": {
        "can_breach": false,
        "can_walk": false,
        "can_path_over_water": false,
        "can_sink": false,
        "can_swim": true,
        "is_amphibious": false
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 32,
          "max_distance": 40
        }
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:nameable": {},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            }
          }
        ]
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "axolotl"
                }
              ]
            },
            "max_dist": 6,
            "walk_speed_multiplier": 1.5,
            "sprint_speed_multiplier": 2
          }
        ]
      },
      "minecraft:behavior.random_swim": {
        "priority": 3,
        "interval": 0,
        "xz_dist": 16,
        "y_dist": 4,
        "speed_multiplier": 1
      },
      "minecraft:behavior.swim_wander": {
        "priority": 4,
        "interval": 0.1,
        "look_ahead": 2
      },
      "minecraft:behavior.swim_idle": {
        "priority": 5
      },
      "minecraft:flocking": {
        "in_water": true,
        "match_variants": false,
        "use_center_of_mass": true,
        "low_flock_limit": 2,
        "high_flock_limit": 6,
        "loner_chance": 0.1,
        "influence_radius": 3,
        "breach_influence": 7,
        "separation_weight": 1.75,
        "separation_threshold": 0.95,
        "cohesion_weight": 2,
        "cohesion_threshold": 1.95,
        "innner_cohesion_threshold": 1.25,
        "goal_weight": 2,
        "min_height": 1.5,
        "max_height": 6,
        "block_distance": 2,
        "block_weight": 0.85
