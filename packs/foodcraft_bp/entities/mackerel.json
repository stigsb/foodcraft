      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "domain": "hand",
                    "subject": "other",
                    "value": "water_bucket"
                  }
                ]
              },
              "event": "foodcraft:caught",
              "target": "self"
            },
            "transform_to_item": "foodcraft:mackerel_bucket",
            "play_sounds": "bucket.fill_fish",
            "interact_text": "action.interact.catch"
          }
        ]
      }
    },
    "events": {
      "foodcraft:caught": {
        "add": {
          "component_groups": [
            "foodcraft:caught"
          ]
        }
