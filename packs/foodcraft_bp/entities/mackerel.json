      },
      "minecraft:scale": {
        "value": 0.9
      },
      "minecraft:collision_box": {
        "width": 0.4,
        "height": 0.3
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/foodcraft_mackerel.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
