{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "foodcraft:trout",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/fish/foodcraft_trout"
      },
      "geometry": {
        "default": "geometry.foodcraft_trout"
      },
      "animations": {
        "swim": "animation.foodcraft_fish.swim",
        "flop": "animation.foodcraft_fish.flop"
      },
      "scripts": {
        "animate": [
          {
            "swim": "query.is_in_water"
          },
          {
            "flop": "!query.is_in_water"
          }
        ]
      },
      "render_controllers": [
        "controller.render.foodcraft_fish"
      ],
      "spawn_egg": {
        "base_color": "#8a8f5a",
        "overlay_color": "#d98c8c"
      }
    }
  }
}
