#!/bin/sh
# Blocks commits that change pack content without bumping the pack version.
# Players and Realms cache packs by UUID + version, so an unchanged version means stale content.
# Enable once per clone: git config core.hooksPath .githooks
changed=$(git diff --cached --name-only -- packs/ | grep -v '/manifest\.json$')
[ -z "$changed" ] && exit 0
exec node tools/check_version_bump.mjs
